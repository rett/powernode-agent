#!/usr/bin/env bash

NAME="$(basename $0)"
CFGFILE="$(dirname $0)/../${NAME}.yml"
LOGFILE="$(dirname $0)/../log/${NAME}.log"
WORKER="$(dirname $0)/../lib/${NAME}.rb"
PIDFILE="$(dirname $0)/../tmp/pids/${NAME}.pid"

manager_requirements="mkisofs mksquashfs rsync ruby sudo"
store_requirements="ruby"

check_requirements()
{
  requirements="${NAME}_requirements"
  requirements="${!requirements}"
  for command in ${requirements}; do
    if [ ! -f "$(which ${command})" ]; then
      not_found="${command} ${not_found}"
    fi
  done
  if [ -n "${not_found}" ]; then
    echo "Not found in path: ${not_found}"
    echo "Aborting!"
    exit 1
  fi
}

pool_getpid()
{
  if [ -f "${PIDFILE}" ]; then
    PID="$(cat ${PIDFILE})"
    if [ ! "$(ps aux | grep ${PID} | grep sidekiq 2>/dev/null)" ]; then
      rm "${PIDFILE}"
      unset PID
    fi
  else
    unset PID
  fi
}

pool_run()
{
  check_requirements
  pool_getpid
  if [ ! "${PID}" ]; then
    echo "Running ${NAME} pool..."
    bundle exec sidekiq -C "${CFGFILE}" -P "${PIDFILE}" -r ${WORKER}
  fi
}

pool_start()
{
  check_requirements
  pool_getpid
  if [ ! "${PID}" ]; then
    echo "Starting ${NAME} pool..."
    bundle exec sidekiq -C "${CFGFILE}" -L "${LOGFILE}" -P "${PIDFILE}" -r "${WORKER}" -d
    while [ ! -f "${PIDFILE}" ]; do
      pool_getpid
      sleep 1
    done
  fi
}

pool_stop()
{
  pool_getpid
  if [ "${PID}" ]; then
    echo "Stopping ${NAME} pool..."
    kill -KILL $PID
    echo "Waiting for workers to finish..."
    while [ -f "${PIDFILE}" ]; do
      pool_getpid
      sleep 1
    done
  fi
}

pool_status()
{
  pool_getpid
  if [ "${PID}" ]; then
    echo "${NAME}: running"
  else
    echo "${NAME}: stopped"
  fi
}

usage()
{
  echo "Usage: $(basename $0) [start|stop|restart|status]"
}

case "$1" in
  start)
    pool_start
    pool_status
    ;;
  run)
    pool_run
    ;;
  stop)
    pool_stop
    pool_status
    ;;
  restart)
    pool_stop
    pool_start
    pool_status
    ;;
  status)
    pool_status
    ;;
  *)
    usage
    ;;
esac
