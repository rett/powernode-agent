#!/usr/bin/env ruby
require 'daemons'
basedir = File.join(File.dirname(__FILE__), '..')

daemon_options = {
  :app_name   => "proxy",
  :dir        => File.join(basedir, '..', 'tmp'),
  :log_dir    => File.join(basedir, '..', 'log'),
  :monitor    => true
}

Daemons.run(File.join(basedir, 'lib', 'proxy.rb'), daemon_options)
