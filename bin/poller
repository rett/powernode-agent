#!/usr/bin/env ruby
require 'daemons'
require 'yaml'

basedir = File.join(File.dirname(__FILE__), '..')
config = YAML::load(File.read(File.join(basedir, 'config.yml')))

daemon_options = {
  :app_name   => 'poller',
  :dir_mode   => :normal,
  :dir        => File.join(basedir, 'tmp'),
  :log_dir    => File.join(basedir, 'log'),
  :monitor    => true
}

Daemons.run(File.join(basedir, 'workers', 'poller.rb'), daemon_options) if config['enable_poller']
