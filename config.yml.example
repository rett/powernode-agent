# Shared options
id: 12345123-3456-012f-7654-1027e1212121
key: secret_key
parent: http://127.0.0.1:3000
realm: Node Alchemy
checksum_bitlength: 256
module_dir: /opt/powernode/store_modules
log_cycle: daily
log_dir: /opt/powernode/manager/log
tmp_dir: /opt/powernode/manager/tmp

# Redis configuration
redis_server: redis://localhost:6379/0
redis_namespace: alchemy

# Poller configuration
poller_interval: 10
poller_logfile: poller.log
poller_loglevel: debug

# Proxy configuration
proxy_logfile: proxy.log
proxy_loglevel: debug

# Manager configuration
manager_queue: manager
manager_logfile: manager.log
manager_loglevel: debug
manager_job_expiration: 3600
manager_job_retries: 0
manager_cloud_error_limit: 3

# Store configuration
store_queue: store
store_logfile: store.log
store_loglevel: debug
store_job_expiration: 3600
store_job_retries: 1
