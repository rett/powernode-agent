# Shared options
id: 12345123-3456-012f-7654-1027e1212121
key: secret_key
node_server_url: http://127.0.0.1:3000
node_proxy_url:
realm: Node Alchemy
domain: powernode.net
module_compression: xz
checksum_bitlength: 256
checksum_util: sha256sum
log_cycle: daily
init_expire: 0:01:00
init_dir: /opt/powernode/init
log_dir: /opt/powernode/node_agent/log
module_dir: /opt/powernode/node_modules
tmp_dir: /opt/powernode/node_agent/tmp

# SMTP options
smtp_from_email: support@nodealchemy.com
smtp_server: mail.powernode.net
smtp_port: 25
smtp_domain: nodealchemy.com
smtp_user_name:
smtp_password:
smtp_authentication:
smtp_enable_starttls_auto: true

# SSL options
ssl_enabled: true
ssl_chain_file: /opt/powernode/node_agent/dev.ipnode.net.pem
ssl_key_file: /opt/powernode/node_agent/dev.ipnode.net.key
ssh_key_dir: /opt/powernode/keys
ssh_port: 22

# Encryption options
encrypted_attributes: [aws_secret_access_key, agent_key, ssh_key]
encryption_cipher: aes-256-cbc
encryption_key: insert_random_key_here
encryption_key_length: 64
encryption_prefix: "encrypted:"

# Redis options
redis_encryption_key: insert_random_key_here
redis_namespace: alchemy
redis_server: redis://localhost:6379/0

# Node Poller options
node_poller_interval: 10
node_poller_logfile: node_poller.log
node_poller_loglevel: debug

# Node Proxy options
node_proxy_ip: 0.0.0.0
node_proxy_port: 4567
node_proxy_logfile: node_proxy.log
node_proxy_loglevel: debug
node_proxy_redirect: false

# Node Mailer options
node_mailer_log_file: node_mailer.log
node_mailer_log_level: debug

# Node Agent options
node_agent_cloud_error_limit: 3
node_agent_job_expiration: 600
node_agent_job_retries: 0
node_agent_logfile: node_agent.log
node_agent_loglevel: debug
node_agent_queue: node_agent

# Node Store options
node_store_queue: store
node_store_logfile: node_store.log
node_store_loglevel: debug
node_store_job_expiration: 600
node_store_job_retries: 1
