# Manager configuration
queue_size: 5

# AMQP configuration
amqp_user: guest
amqp_password: guest
amqp_queue: queue
amqp_servers: 192.168.1.1:5672
amqp_system_name: system
amqp_additional_subscription_servers:
amqp_vhost: /

# Redis configuration
redis_server: 192.168.1.1:6379
redis_servers:
redis_db: 4
redis_failover_timeout: 180.seconds
redis_configuration_master_retries: 3
redis_configuration_master_retry_interval: 10.seconds
redis_configuration_client_timeout: 5.seconds
redis_configuration_client_ids:
