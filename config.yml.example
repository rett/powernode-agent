# Shared options
id: 12345123-3456-012f-7654-1027e1212121
key: secret_key
server_url: http://127.0.0.1:3000
proxy_url:
realm: Node Alchemy
domain: powernode.net
module_compression: xz
checksum_bitlength: 256
checksum_util: sha256sum
log_cycle: daily
init_expire: 0:01:00
init_dir: /opt/powernode/init
log_dir: /opt/powernode/agent/log
module_dir: /opt/powernode/modules
tmp_dir: /opt/powernode/agent/tmp

# SMTP options
smtp_from_email: support@nodealchemy.com
smtp_server: mail.powernode.net
smtp_port: 25
smtp_domain: nodealchemy.com
smtp_user_name:
smtp_password:
smtp_authentication:
smtp_enable_starttls_auto: true

# SSL options
ssl_enabled: true
ssl_chain_file: /opt/powernode/agent/dev.ipnode.net.pem
ssl_key_file: /opt/powernode/agent/dev.ipnode.net.key
ssh_key_dir: /opt/powernode/keys
ssh_port: 22

# Encryption options
encrypted_attributes: [secret_key, agent_key, ssh_key]
encryption_cipher: aes-256-cbc
encryption_key: insert_random_key_here
encryption_key_length: 64
encryption_prefix: "encrypted:"

# Redis options
redis_encryption_key: insert_random_key_here
redis_namespace: alchemy
redis_server: redis://localhost:6379/0

# Node Poller options
poller_interval: 10
poller_logfile: poller.log
poller_loglevel: debug

# Node Proxy options
proxy_ip: 0.0.0.0
proxy_port: 4567
proxy_logfile: proxy.log
proxy_loglevel: debug
proxy_redirect: false

# Node Mailer options
mailer_log_file: mailer.log
mailer_log_level: debug

# Node Agent options
agent_cloud_error_limit: 3
agent_job_expiration: 600
agent_job_retries: 0
agent_logfile: agent.log
agent_loglevel: debug
agent_queue: agent

# Node Store options
store_queue: store
store_logfile: store.log
store_loglevel: debug
store_job_expiration: 600
store_job_retries: 1
